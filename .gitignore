# Ignore everything
/*

# But do not ignore the .gitignore file itself
!.gitignore
!.github/
!.github/*.*
!README.md

# Do not ignore wp-content and everything inside it
!wp-content/
!wp-content/themes/**/*

wp-config.php
wp-content/themes/twenty*/**
wp-content/themes/index.php
wp-content/plugins/index.php
wp-content/uploads/wp-config.php

# Add these lines to .gitignore:
wp-content/plugins/
wp-content/updraft/
wp-content/wflogs/
*.zip
